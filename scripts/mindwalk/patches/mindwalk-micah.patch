+// normalizeClaudeDirs resolves each configured Claude Code directory to a
+// stable absolute path and drops duplicates, preserving first-seen order.
+// Two adapters over the same directory would index every session file twice
+// under two distinct keys carrying the same session ID, so findSession would
+// report every ID in that directory as ambiguous.
+func normalizeClaudeDirs(dirs []string) []string {
+	var out []string
+	for _, dir := range dirs {
+		if dir == "" {
+			continue
+		}
+		if abs, err := filepath.Abs(dir); err == nil {
+			dir = abs
+		}
+		// EvalSymlinks also canonicalizes case on case-insensitive systems;
+		// a directory that does not exist yet keeps its absolute form.
+		if resolved, err := filepath.EvalSymlinks(dir); err == nil {
+			dir = resolved
+		}
+		duplicate := false
+		for _, kept := range out {
+			if sameDir(kept, dir) {
+				duplicate = true
+				break
+			}
+		}
+		if !duplicate {
+			out = append(out, dir)
+		}
+	}
+	// A dir nested under another would be walked twice — the same session
+	// file would enter the list once per root (same Key, so findSession
+	// stays unambiguous, but the rail would show duplicates). Keep only the
+	// shallowest of any nested pair.
+	kept := make([]string, 0, len(out))
+	for i, dir := range out {
+		nested := false
+		for j, other := range out {
+			if i != j && underDir(other, dir) {
+				nested = true
+				break
+			}
+		}
+		if !nested {
+			kept = append(kept, dir)
+		}
+	}
+	return kept
+}
+
+// underDir reports whether child is strictly inside parent (both already
+// normalized by normalizeClaudeDirs).
+func underDir(parent, child string) bool {
+	if sameDir(parent, child) {
+		return false
+	}
+	rel, err := filepath.Rel(parent, child)
+	if err != nil {
+		return false
+	}
+	if rel == "." || rel == ".." || strings.HasPrefix(rel, ".."+string(filepath.Separator)) {
+		return false
+	}
+	return true
+}
+
+// sameDir reports whether two normalized paths name the same directory:
+// string-equal, case-insensitively equal on Windows, or — when both exist —
+// the same file per os.SameFile.
+func sameDir(a, b string) bool {
+	if a == b {
+		return true
+	}
+	if runtime.GOOS == "windows" && strings.EqualFold(a, b) {
+		return true
+	}
+	infoA, errA := os.Stat(a)
+	infoB, errB := os.Stat(b)
+	return errA == nil && errB == nil && os.SameFile(infoA, infoB)
+}

new file mode 100644
index 0000000..4b24eb3
--- /dev/null
+++ b/internal/citymap/cache.go
@@ -0,0 +1,293 @@
+package citymap
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"log"
+	"path"
+	"path/filepath"
+	"runtime/debug"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/cosmtrek/mindwalk/internal/model"
+)
+
+// Scan-cache limits. Package-level vars so tests can shrink them; production
+// code treats them as constants.
+var (
+	// scanCacheTTL is how long a cached ScanResult keeps serving rebuilds.
+	// Within it, untouched files' line counts and the candidate set itself
+	// may age; trace-touched files are always re-inspected fresh by
+	// Compose, so the staleness never lands on the session's own work.
+	scanCacheTTL = 15 * time.Minute
+	// scanCacheMaxEntries bounds the cache; the least recently used entry
+	// is evicted first. Scans are big — up to maxMapFiles inspected files
+	// each — so the cap stays small.
+	scanCacheMaxEntries = 8
+)
+
+// scanFn is the scan entry point CachedBuilder invokes — a package var so
+// tests can wrap it to count cache misses.
+var scanFn = Scan
+
+// CachedBuilder builds citymaps with the same contract as Builder but
+// caches the expensive Scan half, so a snapshot rebuild (trace growth,
+// upstream cache TTL) re-runs only the cheap Compose half: re-inspect the
+// touched files, seat, lay out. Safe for concurrent use; concurrent builds
+// with the same cache key share one scan.
+type CachedBuilder struct {
+	mu       sync.Mutex
+	entries  map[string]*scanEntry
+	inflight map[string]*scanFlight
+	// lastByRoot remembers the most recently stored cache key per root, so a
+	// reseeded workspace scan can serve the previous scan stale while the new
+	// one runs in the background (see cachedScan).
+	lastByRoot map[string]string
+	// revalidating marks roots with a background rescan already in flight.
+	// One at a time per root: a live session touching a new directory per
+	// tick would otherwise stack unbounded concurrent walks of the same
+	// tree (each a multi-minute $HOME walk).
+	revalidating map[string]bool
+}
+
+type scanEntry struct {
+	scan *ScanResult
+	at   time.Time
+	used time.Time
+}
+
+type scanFlight struct {
+	done chan struct{}
+	scan *ScanResult
+	err  error
+}
+
+func NewCachedBuilder() *CachedBuilder {
+	return &CachedBuilder{
+		entries:      map[string]*scanEntry{},
+		inflight:     map[string]*scanFlight{},
+		lastByRoot:   map[string]string{},
+		revalidating: map[string]bool{},
+	}
+}
+
+// Build has the same signature and output as Builder.Build; only the scan
+// half's freshness differs, and only within scanCacheTTL.
+//
+// A nil trace is the explicit repo-map request (/api/repomap): the caller is
+// asking what the repository looks like NOW, and that endpoint keeps its own
+// freshness contract (repoMapTTL) — so it bypasses this cache entirely, read
+// and write.
+func (cb *CachedBuilder) Build(repoRoot string, trace *model.Trace) (*model.CityMap, error) {
+	if trace == nil {
+		return Builder{}.Build(repoRoot, nil)
+	}
+	root, err := filepath.Abs(repoRoot)
+	if err != nil {
+		return nil, err
+	}
+	scan, err := cb.cachedScan(root, touchedPaths(trace))
+	if err != nil {
+		return nil, err
+	}
+	return Compose(root, scan, trace), nil
+}
+
+// cachedScan returns a ScanResult for root, scanning at most once per cache
+// key. Two keys cover the two scan identities: a repo- or project-mode scan
+// ignores the touched set, so it lives under the bare root and every trace
+// reuses it; a workspace-mode scan is seeded by the touched set (see
+// probeProjectRoots), so it lives under root plus a fingerprint of the
+// seed-relevant directories. Which identity a root has is only known after
+// scanning, so lookups try both and the store picks the honest one.
+func (cb *CachedBuilder) cachedScan(root string, touched map[string]bool) (*ScanResult, error) {
+	rootKey := root
+	seededKey := root + "\x00" + seedFingerprint(touched)
+
+	cb.mu.Lock()
+	if scan := cb.lookupLocked(rootKey); scan != nil {
+		cb.mu.Unlock()
+		return scan, nil
+	}
+	if scan := cb.lookupLocked(seededKey); scan != nil {
+		cb.mu.Unlock()
+		return scan, nil
+	}
+	// Stale-while-revalidate: blocking here would freeze a live follow for a
+	// full walk — minutes on a workspace root like $HOME. Two stales can
+	// stand in: the same key just past its soft TTL (grace window, capped at
+	// twice the TTL) and the root's most recent scan under an older seed
+	// set. The session's own touches are always seated fresh by Compose, so
+	// the staleness is confined to the undiscovered neighborhood. Only a
+	// root with no serviceable entry at all still blocks.
+	stale := cb.staleLocked(seededKey)
+	if stale == nil {
+		if lastKey, ok := cb.lastByRoot[root]; ok && lastKey != seededKey {
+			stale = cb.lookupLocked(lastKey)
+			if stale == nil {
+				stale = cb.staleLocked(lastKey)
+			}
+		}
+	}
+	if flight := cb.inflight[seededKey]; flight != nil {
+		if stale != nil {
+			cb.mu.Unlock()
+			return stale, nil
+		}
+		done := flight.done
+		cb.mu.Unlock()
+		<-done
+		return flight.scan, flight.err
+	}
+	if stale != nil && cb.revalidating[root] {
+		// one background walk per root at a time — a follow session touching
+		// a new directory every tick must not stack concurrent full walks;
+		// the next request retries once the running one lands
+		cb.mu.Unlock()
+		return stale, nil
+	}
+	flight := &scanFlight{done: make(chan struct{})}
+	cb.inflight[seededKey] = flight
+	if stale != nil {
+		cb.revalidating[root] = true
+	}
+	cb.mu.Unlock()
+
+	if stale != nil {
+		go cb.runScan(seededKey, rootKey, flight, root, touched, true)
+		return stale, nil
+	}
+	cb.runScan(seededKey, rootKey, flight, root, touched, false)
+	return flight.scan, flight.err
+}
+
+// runScan executes the shared scan without holding the lock and publishes
+// the result on flight. The finalize step — cache the result, drop the
+// inflight entry, close flight.done — runs in a defer so a panicking scan
+// cannot leave later requests blocked forever on a done channel nothing
+// closes. Errors are never cached: the next request scans again. A
+// background revalidation has no caller waiting on the flight, so its
+// failure is logged — silently dropping it would leave the map stale with
+// no signal until the grace window closed.
+func (cb *CachedBuilder) runScan(flightKey, rootKey string, flight *scanFlight, root string, touched map[string]bool, background bool) {
+	defer func() {
+		if r := recover(); r != nil {
+			flight.scan = nil
+			flight.err = fmt.Errorf("scan %s: %v", root, r)
+			log.Printf("mindwalk: panic scanning %s: %v\n%s", root, r, debug.Stack())
+		}
+		if background && flight.err != nil {
+			log.Printf("mindwalk: background rescan of %s failed: %v", root, flight.err)
+		}
+		cb.mu.Lock()
+		if flight.err == nil {
+			key := flightKey
+			if !flight.scan.SeedDriven {
+				// the touched set played no part in this scan — degrade
+				// the key to the bare root so every trace shares it
+				key = rootKey
+			}
+			now := time.Now()
+			cb.entries[key] = &scanEntry{scan: flight.scan, at: now, used: now}
+			cb.lastByRoot[root] = key
+			cb.evictLocked()
+		}
+		delete(cb.inflight, flightKey)
+		if background {
+			delete(cb.revalidating, root)
+		}
+		close(flight.done)
+		cb.mu.Unlock()
+	}()
+	flight.scan, flight.err = scanFn(root, touched)
+}
+
+// lookupLocked returns a fresh cache entry's scan. An entry past its soft
+// TTL is left in place — staleLocked may still serve it within the grace
+// window. Caller must hold mu.
+func (cb *CachedBuilder) lookupLocked(key string) *ScanResult {
+	entry := cb.entries[key]
+	if entry == nil {
+		return nil
+	}
+	if time.Since(entry.at) >= scanCacheTTL {
+		return nil
+	}
+	entry.used = time.Now()
+	return entry.scan
+}
+
+// staleLocked returns an entry past its soft TTL but within the grace
+// window (twice the TTL), keeping it in place while a background
+// revalidation replaces it. Without the grace window, a follow session on a
+// workspace root would freeze for a full walk every TTL expiry. Entries
+// older than the grace window are dropped — stale must not become forever.
+// Caller must hold mu.
+func (cb *CachedBuilder) staleLocked(key string) *ScanResult {
+	entry := cb.entries[key]
+	if entry == nil {
+		return nil
+	}
+	age := time.Since(entry.at)
+	if age < scanCacheTTL {
+		// fresh — lookupLocked's business, not a stale serve
+		return nil
+	}
+	if age >= 2*scanCacheTTL {
+		delete(cb.entries, key)
+		return nil
+	}
+	entry.used = time.Now()
+	return entry.scan
+}
+
+// evictLocked bounds the cache by dropping the least recently used entries
+// once it grows past scanCacheMaxEntries. Caller must hold mu.
+func (cb *CachedBuilder) evictLocked() {
+	for len(cb.entries) > scanCacheMaxEntries {
+		var oldestKey string
+		var oldest time.Time
+		for key, entry := range cb.entries {
+			if oldestKey == "" || entry.used.Before(oldest) {
+				oldestKey = key
+				oldest = entry.used
+			}
+		}
+		if oldestKey == "" {
+			return
+		}
+		delete(cb.entries, oldestKey)
+	}
+}
+
+// seedFingerprint hashes the projection of the touched set that steers a
+// workspace-mode scan: the parent directory of every touched relative path.
+// probeProjectRoots seeds exactly those directories in as scan roots, and
+// their first components are what gate the protected macOS folders, so two
+// touched sets with equal parent-directory sets produce identical scans.
+// Root-level touches and absolute or escaping paths never steer a scan, so
+// they never shape the key either.
+func seedFingerprint(touched map[string]bool) string {
+	dirs := map[string]bool{}
+	for p := range touched {
+		rel := cleanRel(p)
+		if rel == "" || !strings.Contains(rel, "/") {
+			continue
+		}
+		dirs[path.Dir(rel)] = true
+	}
+	if len(dirs) == 0 {
+		return ""
+	}
+	sorted := make([]string, 0, len(dirs))
+	for dir := range dirs {
+		sorted = append(sorted, dir)
+	}
+	sort.Strings(sorted)
+	sum := sha256.Sum256([]byte(strings.Join(sorted, "\x00")))
+	return hex.EncodeToString(sum[:])
+}

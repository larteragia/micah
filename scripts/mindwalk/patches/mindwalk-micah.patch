+package citymap
+
+import (
+	"encoding/json"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/cosmtrek/mindwalk/internal/model"
+)
+
+// drainFlights waits until no scan flight or background revalidation is
+// pending, so a test cannot leak a goroutine that keeps reading the package
+// vars (scanFn, TTLs) after another test's cleanup rewrites them.
+func drainFlights(t *testing.T, cb *CachedBuilder) {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		cb.mu.Lock()
+		idle := len(cb.inflight) == 0 && len(cb.revalidating) == 0
+		cb.mu.Unlock()
+		if idle {
+			return
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("scan flights never drained")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+}
+
+// countScans wraps the package scan entry point so a test can count how many
+// times a CachedBuilder actually re-scanned (cache misses).
+func countScans(t *testing.T) *int32 {
+	t.Helper()
+	var n int32
+	prev := scanFn
+	scanFn = func(root string, touched map[string]bool) (*ScanResult, error) {
+		atomic.AddInt32(&n, 1)
+		return prev(root, touched)
+	}
+	t.Cleanup(func() { scanFn = prev })
+	return &n
+}
+
+func mapJSON(t *testing.T, city *model.CityMap) string {
+	t.Helper()
+	clone := *city
+	clone.Repo.GeneratedAt = ""
+	data, err := json.Marshal(clone)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return string(data)
+}
+
+func hasPath(city *model.CityMap, path string) bool {
+	for _, file := range city.Files {
+		if file.Path == path {
+			return true
+		}
+	}
+	return false
+}
+
+func touchTrace(paths ...string) *model.Trace {
+	targets := make([]model.Target, 0, len(paths))
+	for _, p := range paths {
+		targets = append(targets, model.Target{Path: p, Touch: "read"})
+	}
+	return &model.Trace{Events: []model.Event{{Targets: targets}}}
+}
+
+func TestCachedBuildScansOncePerRoot(t *testing.T) {
+	calls := countScans(t)
+	root := t.TempDir()
+	writeFile(t, root, "src/main.go", "package main\nfunc main() {}\n")
+	writeFile(t, root, "README.md", "# Demo\n")
+	runGit(t, root, "init")
+	runGit(t, root, "add", ".")
+
+	cb := NewCachedBuilder()
+	first, err := cb.Build(root, touchTrace())
+	if err != nil {
+		t.Fatal(err)
+	}
+	second, err := cb.Build(root, touchTrace())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := atomic.LoadInt32(calls); got != 1 {
+		t.Fatalf("scans = %d, want 1 (second build must reuse the cached scan)", got)
+	}
+	if a, b := mapJSON(t, first), mapJSON(t, second); a != b {
+		t.Fatalf("cached rebuild diverged\nfirst=%s\nsecond=%s", a, b)
+	}
+	fresh, err := (Builder{}).Build(root, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a, b := mapJSON(t, second), mapJSON(t, fresh); a != b {
+		t.Fatalf("cached build diverged from fresh build\ncached=%s\nfresh=%s", a, b)
+	}
+}
+
+func TestWorkspaceSeedsChangeTheScanKey(t *testing.T) {
+	calls := countScans(t)
+	root := t.TempDir() // no marker, no git — workspace mode
+	writeFile(t, root, "proj/go.mod", "module proj\n")
+	writeFile(t, root, "notes/a.md", "# a\n")
+	writeFile(t, root, "docs/b.md", "# b\n")
+
+	cb := NewCachedBuilder()
+	notes, err := cb.Build(root, touchTrace("notes/a.md"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := atomic.LoadInt32(calls); got != 1 {
+		t.Fatalf("scans = %d, want 1", got)
+	}
+	if !hasPath(notes, "notes/a.md") || hasPath(notes, "docs/b.md") {
+		t.Fatalf("notes-seeded map wrong: %#v", notes.Files)
+	}
+
+	// A new seed set serves the previous root scan stale and revalidates in
+	// the background: the build returns at once, its own touches seated
+	// fresh by Compose, and the reseeded scan lands shortly after.
+	docs, err := cb.Build(root, touchTrace("docs/b.md"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !hasPath(docs, "docs/b.md") {
+		t.Fatalf("stale-based map missing its own touched file: %#v", docs.Files)
+	}
+	deadline := time.Now().Add(10 * time.Second)
+	for atomic.LoadInt32(calls) < 2 {
+		if time.Now().After(deadline) {
+			t.Fatalf("scans = %d, want 2 (background reseeded scan never ran)", atomic.LoadInt32(calls))
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+
+	// once the background scan lands, the seeded entry serves without a
+	// third scan — poll because landing happens after the counter bumps
+	deadline = time.Now().Add(10 * time.Second)
+	for {
+		docs2, err := cb.Build(root, touchTrace("docs/b.md"))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if hasPath(docs2, "docs/b.md") && atomic.LoadInt32(calls) == 2 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("reseeded entry never became servable (scans = %d)", atomic.LoadInt32(calls))
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+
+	// the first seed set must still be cached
+	if _, err := cb.Build(root, touchTrace("notes/a.md")); err != nil {
+		t.Fatal(err)
+	}
+	if got := atomic.LoadInt32(calls); got != 2 {
+		t.Fatalf("scans = %d, want 2 (earlier seed set must still hit)", got)
+	}
+	drainFlights(t, cb)
+}
+
+func TestRepoModeKeyIgnoresSeeds(t *testing.T) {
+	calls := countScans(t)
+	root := t.TempDir()
+	writeFile(t, root, "a/a.go", "package a\n")
+	writeFile(t, root, "b/b.go", "package b\n")
+	runGit(t, root, "init")
+	runGit(t, root, "add", ".")
+
+	cb := NewCachedBuilder()
+	if _, err := cb.Build(root, touchTrace("a/a.go")); err != nil {
+		t.Fatal(err)
+	}
+	city, err := cb.Build(root, touchTrace("b/b.go"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := atomic.LoadInt32(calls); got != 1 {
+		t.Fatalf("scans = %d, want 1 (repo-mode scans ignore seeds — the key must degrade to the root)", got)
+	}
+	if !hasPath(city, "b/b.go") {
+		t.Fatalf("touched file missing from cached-scan build: %#v", city.Files)
+	}
+}
+
+func TestComposeDoesNotMutateScanResult(t *testing.T) {
+	root := t.TempDir()
+	writeFile(t, root, "src/main.go", "package main\nfunc main() {}\n")
+	writeFile(t, root, "src/util.go", "package main\nfunc util() {}\n")
+	writeFile(t, root, "README.md", "# Demo\n")
+	runGit(t, root, "init")
+	runGit(t, root, "add", ".")
+
+	scan, err := Scan(root, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	before, err := json.Marshal(scan)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// touch one existing file (fresh re-inspection supersedes the pool
+	// copy) and one missing file (ghost) so every seating tier runs
+	trace := touchTrace("src/main.go", "missing.go")
+	first := Compose(root, scan, trace)
+	second := Compose(root, scan, trace)
+	if a, b := mapJSON(t, first), mapJSON(t, second); a != b {
+		t.Fatalf("two composes over one scan diverged\nfirst=%s\nsecond=%s", a, b)
+	}
+
+	// the maps must be independent: wrecking one cannot bleed into the
+	// other or back into the scan
+	secondBefore := mapJSON(t, second)
+	for i := range first.Files {
+		first.Files[i].ID = -1
+		first.Files[i].Lines = -1
+		first.Files[i].Rect = model.Rect{X: -1, Z: -1, W: -1, D: -1}
+	}
+	if got := mapJSON(t, second); got != secondBefore {
+		t.Fatal("mutating one composed map changed another")
+	}
+	after, err := json.Marshal(scan)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(after) != string(before) {
+		t.Fatalf("Compose mutated the ScanResult\nbefore=%s\nafter=%s", before, after)
+	}
+}
+
+func TestConcurrentBuildsShareOneScan(t *testing.T) {
+	calls := countScans(t)
+	root := t.TempDir()
+	writeFile(t, root, "main.go", "package main\n")
+	runGit(t, root, "init")
+	runGit(t, root, "add", ".")
+
+	cb := NewCachedBuilder()
+	const n = 8
+	maps := make([]*model.CityMap, n)
+	errs := make([]error, n)
+	var wg sync.WaitGroup
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			maps[i], errs[i] = cb.Build(root, touchTrace())
+		}(i)
+	}
+	wg.Wait()
+	for i := 0; i < n; i++ {
+		if errs[i] != nil {
+			t.Fatal(errs[i])
+		}
+		if maps[i] == nil || !hasPath(maps[i], "main.go") {
+			t.Fatalf("build %d returned a wrong map: %#v", i, maps[i])
+		}
+	}
+	if got := atomic.LoadInt32(calls); got != 1 {
+		t.Fatalf("scans = %d, want 1 (concurrent builds must share one scan)", got)
+	}
+}
+
+func TestScanCacheExpiresByTTL(t *testing.T) {
+	prev := scanCacheTTL
+	scanCacheTTL = 0
+	t.Cleanup(func() { scanCacheTTL = prev })
+
+	calls := countScans(t)
+	root := t.TempDir()
+	writeFile(t, root, "main.go", "package main\n")
+	runGit(t, root, "init")
+	runGit(t, root, "add", ".")
+
+	cb := NewCachedBuilder()
+	for i := 0; i < 2; i++ {
+		if _, err := cb.Build(root, touchTrace()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := atomic.LoadInt32(calls); got != 2 {
+		t.Fatalf("scans = %d, want 2 (expired entries must re-scan)", got)
+	}
+}
+
+func TestScanCacheEvictsLeastRecentlyUsed(t *testing.T) {
+	prev := scanCacheMaxEntries
+	scanCacheMaxEntries = 1
+	t.Cleanup(func() { scanCacheMaxEntries = prev })
+
+	calls := countScans(t)
+	rootA := t.TempDir()
+	writeFile(t, rootA, "a.go", "package a\n")
+	runGit(t, rootA, "init")
+	runGit(t, rootA, "add", ".")
+	rootB := t.TempDir()
+	writeFile(t, rootB, "b.go", "package b\n")
+	runGit(t, rootB, "init")
+	runGit(t, rootB, "add", ".")
+
+	cb := NewCachedBuilder()
+	for _, root := range []string{rootA, rootB, rootA} {
+		if _, err := cb.Build(root, touchTrace()); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if got := atomic.LoadInt32(calls); got != 3 {
+		t.Fatalf("scans = %d, want 3 (cap 1 must evict the older root)", got)
+	}
+}
+
+func TestScanErrorsAreNotCached(t *testing.T) {
+	calls := countScans(t)
+	root := t.TempDir() // empty: the scan finds nothing and errors
+
+	cb := NewCachedBuilder()
+	if _, err := cb.Build(root, touchTrace()); err == nil {
+		t.Fatal("expected an error for an empty root")
+	}
+	writeFile(t, root, "main.go", "package main\n")
+	city, err := cb.Build(root, touchTrace())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !hasPath(city, "main.go") {
+		t.Fatalf("files = %#v", city.Files)
+	}
+	if got := atomic.LoadInt32(calls); got != 2 {
+		t.Fatalf("scans = %d, want 2 (errors must never be cached)", got)
+	}
+}
+
+// TestReseededScanNeverBlocksTheCaller pins the stale-while-revalidate
+// contract: while the reseeded background scan is still running — however
+// long it takes — builds for that root keep answering instantly from the
+// previous scan instead of blocking a live follow.
+func TestReseededScanNeverBlocksTheCaller(t *testing.T) {
+	root := t.TempDir() // workspace mode
+	writeFile(t, root, "proj/go.mod", "module proj\n")
+	writeFile(t, root, "notes/a.md", "# a\n")
+	writeFile(t, root, "docs/b.md", "# b\n")
+
+	gate := make(chan struct{})
+	var releaseGate sync.Once
+	release := func() { releaseGate.Do(func() { close(gate) }) }
+	var scans int32
+	prev := scanFn
+	scanFn = func(r string, touched map[string]bool) (*ScanResult, error) {
+		if atomic.AddInt32(&scans, 1) > 1 {
+			<-gate // every scan after the first hangs until released
+		}
+		return prev(r, touched)
+	}
+	t.Cleanup(func() { release(); scanFn = prev })
+
+	cb := NewCachedBuilder()
+	if _, err := cb.Build(root, touchTrace("notes/a.md")); err != nil {
+		t.Fatal(err)
+	}
+
+	// the reseeded build must return before the gated scan completes
+	done := make(chan *model.CityMap, 1)
+	go func() {
+		city, err := cb.Build(root, touchTrace("docs/b.md"))
+		if err != nil {
+			t.Error(err)
+		}
+		done <- city
+	}()
+	select {
+	case city := <-done:
+		if !hasPath(city, "docs/b.md") {
+			t.Fatalf("stale-based map missing its own touched file: %#v", city.Files)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("reseeded build blocked on the background scan")
+	}
+
+	// and so must every later build while the flight is still gated
+	if _, err := cb.Build(root, touchTrace("docs/b.md", "notes/a.md")); err != nil {
+		t.Fatal(err)
+	}
+
+	// drain before cleanup rewrites the package vars under the goroutine
+	release()
+	drainFlights(t, cb)
+}
+
+// TestOneBackgroundRevalidationPerRoot pins the herd guard: a follow session
+// touching a new directory every tick must not stack concurrent full walks
+// of the same root — while one background rescan runs, further reseeded
+// builds serve stale without spawning another.
+func TestOneBackgroundRevalidationPerRoot(t *testing.T) {
+	root := t.TempDir() // workspace mode
+	writeFile(t, root, "proj/go.mod", "module proj\n")
+	writeFile(t, root, "notes/a.md", "# a\n")
+	writeFile(t, root, "docs/b.md", "# b\n")
+	writeFile(t, root, "letters/c.md", "# c\n")
+
+	gate := make(chan struct{})
+	var releaseGate sync.Once
+	release := func() { releaseGate.Do(func() { close(gate) }) }
+	var scans int32
+	prev := scanFn
+	scanFn = func(r string, touched map[string]bool) (*ScanResult, error) {
+		if atomic.AddInt32(&scans, 1) > 1 {
+			<-gate
+		}
+		return prev(r, touched)
+	}
+	t.Cleanup(func() { release(); scanFn = prev })
+
+	cb := NewCachedBuilder()
+	if _, err := cb.Build(root, touchTrace("notes/a.md")); err != nil {
+		t.Fatal(err)
+	}
+
+	// first new seed spawns the one allowed background rescan (gated)
+	if _, err := cb.Build(root, touchTrace("docs/b.md")); err != nil {
+		t.Fatal(err)
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for atomic.LoadInt32(&scans) < 2 {
+		if time.Now().After(deadline) {
+			t.Fatal("background rescan never started")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+
+	// second new seed while the first is still walking: stale, no new spawn
+	city, err := cb.Build(root, touchTrace("letters/c.md"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !hasPath(city, "letters/c.md") {
+		t.Fatalf("stale-based map missing its own touched file: %#v", city.Files)
+	}
+	if got := atomic.LoadInt32(&scans); got != 2 {
+		t.Fatalf("scans = %d, want 2 (a second background walk was spawned)", got)
+	}
+
+	release()
+	drainFlights(t, cb)
+	if got := atomic.LoadInt32(&scans); got != 2 {
+		t.Fatalf("scans = %d after drain, want 2", got)
+	}
+}
+
+// TestExpiredEntryServesStaleWithinGrace pins the TTL grace window: a seed-
+// stable follow session must not freeze for a full walk when the cache
+// entry crosses its soft TTL — the expired entry stands in one more round
+// while the rescan runs in the background.
+func TestExpiredEntryServesStaleWithinGrace(t *testing.T) {
+	prevTTL := scanCacheTTL
+	scanCacheTTL = 200 * time.Millisecond
+	t.Cleanup(func() { scanCacheTTL = prevTTL })
+
+	root := t.TempDir() // workspace mode
+	writeFile(t, root, "proj/go.mod", "module proj\n")
+	writeFile(t, root, "notes/a.md", "# a\n")
+
+	gate := make(chan struct{})
+	var releaseGate sync.Once
+	release := func() { releaseGate.Do(func() { close(gate) }) }
+	var scans int32
+	prev := scanFn
+	scanFn = func(r string, touched map[string]bool) (*ScanResult, error) {
+		if atomic.AddInt32(&scans, 1) > 1 {
+			<-gate
+		}
+		return prev(r, touched)
+	}
+	t.Cleanup(func() { release(); scanFn = prev })
+
+	cb := NewCachedBuilder()
+	if _, err := cb.Build(root, touchTrace("notes/a.md")); err != nil {
+		t.Fatal(err)
+	}
+
+	// cross the soft TTL but stay inside the grace window (2×TTL)
+	time.Sleep(250 * time.Millisecond)
+
+	done := make(chan *model.CityMap, 1)
+	go func() {
+		city, err := cb.Build(root, touchTrace("notes/a.md"))
+		if err != nil {
+			t.Error(err)
+		}
+		done <- city
+	}()
+	select {
+	case city := <-done:
+		if !hasPath(city, "notes/a.md") {
+			t.Fatalf("grace-served map missing the touched file: %#v", city.Files)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("build blocked on TTL expiry instead of serving the grace-window stale")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for atomic.LoadInt32(&scans) < 2 {
+		if time.Now().After(deadline) {
+			t.Fatal("expiry never revalidated in background")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+
+	release()
+	drainFlights(t, cb)
+	if got := atomic.LoadInt32(&scans); got != 2 {
+		t.Fatalf("scans = %d after drain, want 2", got)
+	}
+}

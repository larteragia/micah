+	writeServerSession(t, filepath.Join(claudeDir, "solo.jsonl"),
+		`{"type":"user","timestamp":"2026-07-09T00:00:00Z","sessionId":"solo-id","cwd":"/tmp","message":{"role":"user","content":"hello"}}`,
+	)
+
+	variant := strings.ToUpper(claudeDir)
+	if variant == claudeDir {
+		t.Skipf("temp dir %q has no case-variant spelling", claudeDir)
+	}
+	s := New(Config{ClaudeDirs: []string{claudeDir, variant}, CodexDir: filepath.Join(t.TempDir(), "codex"), PiDir: filepath.Join(t.TempDir(), "pi")})
+	if got := countClaudeAdapters(s); got != 1 {
+		t.Fatalf("claude adapters = %d, want 1", got)
+	}
+	meta, err := s.findSession("solo-id")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if meta.ID != "solo-id" {
+		t.Fatalf("meta = %#v", meta)
+	}
+}
+
+// TestSingleClaudeDirConfigStillBuildsOneAdapter pins the compat path: the
+// old single-dir field keeps working, alone and mixed with ClaudeDirs.
+func TestSingleClaudeDirConfigStillBuildsOneAdapter(t *testing.T) {
+	claudeDir := t.TempDir()
+	s := New(Config{ClaudeDir: claudeDir})
+	if got := countClaudeAdapters(s); got != 1 {
+		t.Fatalf("claude adapters = %d, want 1", got)
+	}
+	mixed := New(Config{ClaudeDirs: []string{claudeDir}, ClaudeDir: claudeDir})
+	if got := countClaudeAdapters(mixed); got != 1 {
+		t.Fatalf("claude adapters with both fields = %d, want 1", got)
+	}
+}
+
+func countClaudeAdapters(s *Server) int {
+	count := 0
+	for _, source := range s.adapters {
+		if source.Harness() == "claude-code" {
+			count++
+		}
+	}
+	return count
+}
+
+// A dir nested inside another passed root would be walked twice and list the
+// same session once per root — only the shallowest of a nested pair stays.
+func TestNestedClaudeDirsKeepTheShallowest(t *testing.T) {
+	claudeDir := t.TempDir()
+	nested := filepath.Join(claudeDir, "proj-x")
+	if err := os.MkdirAll(nested, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	writeServerSession(t, filepath.Join(nested, "solo.jsonl"),
+		`{"type":"user","timestamp":"2026-07-09T00:00:00Z","sessionId":"solo-id","cwd":"/tmp","message":{"role":"user","content":"hello"}}`,
+	)
+
+	s := New(Config{ClaudeDirs: []string{claudeDir, nested}, CodexDir: filepath.Join(t.TempDir(), "codex"), PiDir: filepath.Join(t.TempDir(), "pi")})
+	if got := countClaudeAdapters(s); got != 1 {
+		t.Fatalf("claude adapters = %d, want 1 (nested dir must collapse into its parent)", got)
+	}
+	sessions, err := s.listSessions()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(sessions) != 1 {
+		t.Fatalf("sessions = %#v, want the nested session listed exactly once", sessions)
+	}
+}
